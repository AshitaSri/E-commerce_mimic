# Copy this file to .env (which is gitignored) and fill in your real values.
# .env lives at the project root — every service loads it automatically.

# New Relic — get your License key (INGEST - LICENSE type) from
# https://one.newrelic.com -> account menu -> API keys
NEW_RELIC_LICENSE_KEY=paste-your-license-key-here

# Skips the newrelic.js config file requirement — we configure the agent
# entirely through environment variables instead.
NEW_RELIC_NO_CONFIG_FILE=true

# Send agent logs to stdout instead of writing a log file per service.
NEW_RELIC_LOG=stdout
